# =====================================================================
#  BYOK secrets — REAL values go HERE (in your shell profile), not in
#  config.yaml.  Copy this to ~/.zshrc (or ~/.bash_profile) and fill in.
#  Then:  source ~/.zshrc
#
#  This file is a TEMPLATE — keep it empty/placeholder. Put the real
#  one in your profile and chmod 600 it.
# =====================================================================

# --- Core 4 (+ Ollama) ------------------------------------------------
export GITHUB_TOKEN="<paste ghp_...>"
export HF_TOKEN="<paste hf_...>"
export TAVILY_API_KEY="<paste tvly-...>"
export OPENROUTER_API_KEY="<paste sk-or-...>"
export OLLAMA_API_KEY="ollama-local"        # local server; placeholder ok

# --- GLM gateways (add when you create these) -------------------------
# Z.AI direct: native GLM-5.3 (cheapest, 1M ctx).  Key from z.ai
export ZAI_API_KEY="<paste sk-...>"
# ai&: one key -> GLM/Kimi/DeepSeek/Qwen.  Key from aiand.com
# export AIAND_API_KEY="<paste sk-...>"
# NVIDIA NIM: FREE GLM-5.3-Flash.  Key from build.nvidia.com
# export NVIDIA_API_KEY="<paste nvapi-...>"

# --- "More is better" (add when you create these) ---------------------
# export ANTHROPIC_API_KEY="<paste sk-ant-...>"
# export OPENAI_API_KEY="<paste sk-...>"
# export GEMINI_API_KEY="<paste AIza...>"
