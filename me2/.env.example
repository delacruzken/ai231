# Copy to me2/.env and fill in (never commit .env).
# Spotify Developer Dashboard → your app → Settings

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must match a Redirect URI registered on the dashboard exactly:
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# güdmüd playlist (override if needed)
SPOTIFY_PLAYLIST_URI=spotify:playlist:3eurayPQQ7IvoqkkletA89
