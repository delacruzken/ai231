# Copy to .env and fill when credentials are provisioned.
# Pending settings remain explicit; do not commit real secrets.

# Anthropic (Claude Haiku 5.5) — Phase 3+
ANTHROPIC_API_KEY=

# Tavily search/extraction — Phase 5+
TAVILY_API_KEY=

# OpenCode local server (Phase 6) — NOT a cloud API key
# Start with: opencode serve --port 4096
# Optional basic auth if the server sets OPENCODE_SERVER_PASSWORD
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
# Force MockWorker even if OpenCode is reachable
OPENCODE_FORCE_MOCK=false

# GitHub publication (server-side only; never expose to UI) — Phase 7+
# PAT needs repo contents:write; Pages must already be enabled on the repo.
GITHUB_PAT=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
# Path inside the repo for site files (GitHub Pages "docs/" folder is common)
GITHUB_SITE_ROOT=docs
# Optional override if Pages URL is non-standard
GITHUB_PAGES_URL=

# Phase 2 session UI access token (required when ui.require_token is true)
ME3_UI_TOKEN=dev-token-change-me

# Optional: override settings file path
# ME3_SETTINGS=/path/to/settings.yaml

# Benchmark direct-feed (Phase 8). Usually set by launch_assistant / fdbench.
# FDBENCH_URL=ws://127.0.0.1:8791
# FDBENCH_PROJECT=/absolute/path/to/me3/voice-agent
# FDBENCH_ENTRY=/absolute/path/to/me3/voice-agent/scripts/fdbench_assistant_entry.py
